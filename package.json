{
  "name": "miniclaw",
  "version": "1.0.0",
  "description": "OpenDot: self-hosted personal AI assistant and team powered by Pi Runtime.",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "self-test": "npm run build:all && npm run self-test:agent-runner && npm test -- --run",
    "self-test:agent-runner": "tsx scripts/self-test-agent-runner.ts",
    "demo:durable-runtime": "vitest run tests/pi-durable-runtime.test.ts tests/pi-durable-input-ledger.test.ts tests/pi-durable-process-recovery.test.ts tests/pi-durable-ownership.test.ts tests/durable-model-smoke.test.ts",
    "device-node": "tsx scripts/device-node.ts",
    "demo:personal-goals": "tsx scripts/test-personal-goals-http-smoke.ts",
    "reset:admin": "tsx src/reset-admin.ts",
    "typecheck": "tsc --noEmit && npm run typecheck:personal-agent",
    "typecheck:personal-agent": "tsc -p tsconfig.personal-agent.json",
    "format": "prettier --write \"src/**/*.ts\"",
    "format:check": "node scripts/check-format-changed.mjs",
    "format:changed": "node scripts/check-format-changed.mjs --write",
    "docs:check": "node scripts/check-docs.mjs",
    "test": "node scripts/run-node-cli.mjs vitest",
    "test:real-model": "tsx scripts/test-real-model-smoke.ts",
    "test:personal-agent-live": "node --import tsx scripts/test-personal-agent-live.ts",
    "test:bot-team-live": "node --import tsx scripts/test-personal-agent-live.ts --bot-team",
    "test:durable-zen-real-model": "node --use-env-proxy --import tsx scripts/test-durable-zen-smoke.ts",
    "dev:all": "npx concurrently --timestamp-format \"yyyy-MM-dd HH:mm:ss.SSS\" -n backend,frontend -c blue,green \"npm run dev\" \"npm run dev:web\"",
    "dev:web": "cd web && npm run dev",
    "build:web": "cd web && npm run build",
    "build:all": "node scripts/run-node-cli.mjs concurrently --group -n backend,web,agent-runner \"npm run build\" \"npm run build:web\" \"npm --prefix container/agent-runner run build\"",
    "desktop:build": "npm run desktop:build:main && npm run desktop:build:preload",
    "desktop:build:main": "esbuild electron/src/main/index.ts --bundle --platform=node --format=cjs --outfile=electron/dist/main.cjs --sourcemap --external:electron",
    "desktop:build:preload": "esbuild electron/src/preload/index.ts --bundle --platform=node --format=cjs --outfile=electron/dist/preload.cjs --sourcemap --external:electron",
    "desktop:typecheck": "tsc --noEmit -p electron/tsconfig.json",
    "desktop:dev": "npm run desktop:build && electron electron",
    "desktop:package": "npm run build:all && npm run desktop:build && electron-builder --projectDir electron --config electron-builder.yml",
    "desktop:package:dir": "npm run build:all && npm run desktop:build && electron-builder --dir --projectDir electron --config electron-builder.yml",
    "test:cloud-authority": "node scripts/run-node-cli.mjs vitest run --config vitest.cloud-authority.config.ts"
  },
  "dependencies": {
    "@earendil-works/chord": "1.3.0",
    "@earendil-works/pi-ai": "1.3.0",
    "@earendil-works/pi-coding-agent": "0.84.2",
    "@earendil-works/pi-durable": "1.3.0",
    "@hono/node-server": "^2.0.12",
    "@larksuiteoapi/node-sdk": "^1.58.0",
    "adm-zip": "^0.6.0",
    "baileys": "^7.0.0-rc13",
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "^12.10.0",
    "cron-parser": "^5.5.0",
    "dingtalk-stream": "2.1.6-beta.1",
    "discord.js": "^14.26.2",
    "grammy": "^1.40.0",
    "hono": "^4.12.25",
    "jpeg-js": "0.4.4",
    "node-pty": "^1.1.0",
    "pngjs": "5.0.0",
    "pino": "^9.6.0",
    "pino-pretty": "^13.0.0",
    "proxy-agent": "^6.5.0",
    "qrcode": "^1.5.4",
    "undici": "6.27.0",
    "ws": "^8.19.0",
    "yaml": "^2.8.3",
    "zod": "^4.3.6",
    "@earendil-works/pi-mcp": "1.3.0",
    "ajv": "8.20.0",
    "@langfuse/client": "6.0.2",
    "@langfuse/otel": "6.0.2",
    "@langfuse/tracing": "6.0.2",
    "@opentelemetry/api": "1.9.0",
    "@opentelemetry/core": "2.5.1",
    "@opentelemetry/exporter-trace-otlp-http": "0.212.0",
    "@opentelemetry/otlp-exporter-base": "0.212.0",
    "@opentelemetry/otlp-transformer": "0.212.0",
    "@opentelemetry/sdk-trace-base": "2.5.1"
  },
  "devDependencies": {
    "@types/adm-zip": "^0.5.8",
    "@types/bcryptjs": "^2.4.6",
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.10.0",
    "@types/qrcode": "^1.5.6",
    "@types/ws": "^8.18.1",
    "concurrently": "^9.2.1",
    "happy-dom": "^20.11.1",
    "prettier": "3.8.3",
    "tsx": "^4.19.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.1",
    "electron": "39.8.10",
    "electron-builder": "^26.0.12",
    "esbuild": "^0.25.0"
  },
  "overrides": {
    "libsignal": "6.0.0"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yftx293/OpenDot.git"
  },
  "homepage": "https://github.com/yftx293/OpenDot#readme",
  "bugs": {
    "url": "https://github.com/yftx293/OpenDot/issues"
  },
  "author": "Yu (https://github.com/yftx293)",
  "keywords": [
    "pi-agent",
    "pi-coding-agent",
    "ai-agent",
    "self-hosted",
    "feishu",
    "lark",
    "telegram",
    "chatbot",
    "docker",
    "mcp",
    "electron",
    "desktop"
  ]
}
